@using Orgksetra.ViewModel
@model ItemDetails
@{
    Layout = "~/Views/Shared/_ProductLayout.cshtml";
}

    <html>
        <head>
      <link rel="stylesheet" href="~/css/itemDetails.css" type="text/css" />
      <link rel="stylesheet" href="~/css/mainPage.css" type="text/css" />
        </head>
        <body>
                <div class="row col-md-12">
                <div class="col-md-6">
            <div class="imagediv"> 
                @if (Model.ImageData != null)
                {
                    <img src="data:image/png;base64,@Convert.ToBase64String(Model.ImageData)" alt="Model.ItemName" class="img-food" /><br />
                    
                }else
                {   
                    <img src="" class="img-food" alt="Model.ItemName" />
                }
            </div>
            </div>
            <div class="col-md-6">
       
            <h2 id="itemname">@Model.ItemName</h2>
            <p class="itemdesc"><b>Price:</b> ₹@Model.ItemPrice per @Model.ItemUnit</p>
            <p class="itemdesc"><b>Description: </b> @Model.ItemDescription</p>
            <p class="itemdesc"><b>Item Type: </b> @Model.ItemType</p>
            <div class="container">
                <a class="btn btn-success Updatebtn" onclick="AddToCart(event,@Model.ItemId)" >Add To <i class="fa-solid fa-cart-shopping"></i></a>
            </div>
        </div>
        </div>
     
        </body>
    </html>
    <script>
    function AddToCart(e, id) {
        $.ajax({
            url: '/Cart/Add_Cart', // Example API URL
            type: 'Post',  // Request type (GET, POST, etc.)
            data: {
                id: id,
            },
            dataType: 'json',  // Expected response type
            success: function (response) {
                $(e.target).text('Added');
                $(e.target).attr('disabled', true);
            },
            error: function (xhr, status, error) {
                // Handle any errors that occur during the request
                console.error("Error: " + error);
                alert("Something went wrong!");
            }

        });
    }
    </script>