@model IEnumerable<Item>
@{
    Layout = "~/Views/Shared/_ProductLayout.cshtml";
}
<html>
<head>
    <style>
        html, body {
            min-height: 100% !important;
            width: 100% !important;
        }

        h1 {
            text-align: center;
            font-family: Cambria, Cochin, Georgia, Times, Times New Roman, serif;
            font-weight: 400;
            padding-top: 8%;
        }

        .paragraphsec {
            text-align: center;
            padding-left: 5rem;
            background-color: aliceblue;
        }

        .bodysection {
            height: 400px;
            width: 100%;
            background-image: url("../Assets/OrganicFarm.jpg");
            background-repeat: no-repeat;
            background-size: cover;
            margin-bottom: 10px;
        }

        .cards {
            margin: auto;
            padding-top: 50px;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
        }

        .card1 {
            height: 380px;
            width: 370px;
            box-shadow: 10px 5px 15px 5px #737373;
            margin: 2rem 0.5rem 0rem 3rem;
            display: flex;
            transition: transform 0.3s ease;
        }

        .cardcontent {
            min-height: 100%;
            min-width: 100%;
            display: flex;
            justify-content: center;
            justify-items: center;
            border: 1px solid black;
            display: inline-block;
            object-fit: cover;
            margin: 0rem 0rem 0rem 0rem;
            background-color: aliceblue;
        }

        .img-food {
            height: 80%;
            width: 23rem;
            object-fit: cover;
            object-position: center;
            background-repeat: no-repeat;
            overflow: hidden;
        }

        .card-desc p {
            margin: 15px 0px 0px 15px;
            font-weight: 500;
            font-size: 20px;
        }

        .card-desc button {
            overflow: hidden;
            float: inline-end;
            margin-top: 12px;
        }

        .card-desc {
            display: flex;
            justify-content: space-evenly;
            width: 100%;
            height: auto;
        }

        .card1:hover {
            /*animation: mymove 0.5s linear;*/
            transform: scale(1.04);
        }

        #WelcomeName {
            font-family: Cambria, Cochin, Georgia, Times, Times New Roman, serif;
            font-weight:400;
            float:right;
            padding:1rem;

            font-size:1.5rem;
        }
   
    </style>
</head>
<body>
    <div>
        <h2 id="WelcomeName">Welcome, @ViewBag.CustomerName</h2>   
        </div>
    <div>
    <h1>All Products</h1>
    <p class="paragraphsec">Get your product..</p>

    <div class="cards">
        @foreach (var item in Model)
        {
            <div class="card1">
                <div class="cardcontent">
                    <a href="@Url.Action("ItemDetails", "Cust_Item", new {Id = @item.ItemId})"><img src="data:image/png;base64,@Convert.ToBase64String(item.images.ImageData)" alt="@item.ItemName" class="img-food" /></a>

                    <div class="card-desc">
                        <p>Price: @item.ItemPrice </p>
                        <h6>@item.ItemName</h6>
                        <a class="btn btn-outline-success mt-3" asp-action="Add_Cart" asp-controller="Cart" asp-route-id="@item.ItemId">Add Cart</a>
                    </div>
                </div>

            </div>
        }
    </div>
    </div>
</body>
</html>